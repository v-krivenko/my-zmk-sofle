#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mt {
    quick-tap-ms = <175>;
    flavor = "balanced";
};

&lt { quick-tap-ms = <175>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    esc_tilde: esc_tilde {
        compatible = "zmk,behavior-mod-morph";
        label = "ESC_TILDE";
        bindings = <&kp ESC>, <&kp TILDE>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    tilde_esc: tilde_esc {
        compatible = "zmk,behavior-tap-dance";
        label = "TILDE_ESC";
        #binding-cells = <0>;
        bindings = <&kp GRAVE>, <&kp ESC>;
    };

    long_press: long_press {
        compatible = "zmk,behavior-hold-tap";
        label = "LONG_PRESS";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <175>;
        quick-tap-ms = <0>;
        flavor = "tap-preferred";
    };

    fast_lt: fast_lt {
        compatible = "zmk,behavior-hold-tap";
        label = "FAST_LT";
        bindings = <&mo>, <&kp>;

        #binding-cells = <2>;
        flavor = "balanced";
        tapping-term-ms = <150>;
    };

    fast_mt: fast_mt {
        compatible = "zmk,behavior-hold-tap";
        label = "FAST_MT";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <150>;
        flavor = "balanced";
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
            layers = <3>;
        };

        L1_toggle {
            bindings = <&tog 1>;
            key-positions = <56 57 55>;
            layers = <0 1>;
        };

        L2_toggle {
            bindings = <&tog 2>;
            key-positions = <59 60 61>;
            layers = <0 2>;
        };

        L3_SYS {
            bindings = <&mo 3>;
            key-positions = <53 54>;
        };

        eq_arrow {
            bindings = <&eq_arrow>;
            key-positions = <62 49>;
            layers = <0>;
        };

        arrow {
            bindings = <&arrow>;
            key-positions = <63 49>;
            layers = <0>;
        };

        L_BRACKET {
            bindings = <&long_press LEFT_BRACE LBKT>;
            key-positions = <34 35>;
            require-prior-idle-ms = <120>;
        };

        R_BRACKET {
            bindings = <&long_press RIGHT_BRACE RBKT>;
            key-positions = <35 36>;
            require-prior-idle-ms = <120>;
        };

        equal_and_plus {
            bindings = <&long_press PLUS EQUAL>;
            key-positions = <21 22>;
            require-prior-idle-ms = <120>;
        };

        minus_and_underscore {
            bindings = <&long_press UNDER MINUS>;
            key-positions = <23 22>;
            require-prior-idle-ms = <120>;
        };

        c_end {
            bindings = <&kp END>;
            key-positions = <48 49>;
            require-prior-idle-ms = <120>;
        };

        c_home {
            bindings = <&kp HOME>;
            key-positions = <48 47>;
            require-prior-idle-ms = <120>;
        };

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <16 15>;
            require-prior-idle-ms = <200>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <29 28>;
            require-prior-idle-ms = <200>;
        };

        EN_lang {
            bindings = <&kp LANG2>;
            key-positions = <56 31>;
            layers = <0 2>;
        };

        RU_lang {
            bindings = <&kp LANG3>;
            key-positions = <56 44>;
            layers = <0 2>;
        };

        UA_lang {
            bindings = <&kp LANG1>;
            key-positions = <56 18>;
            layers = <0 2>;
        };
    };

    macros {
        arrow: arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
            label = "ARROW";
        };

        eq_arrow: eq_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "EQ_ARROW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&long_press TILDE GRAVE  &kp N1                     &kp N2                 &kp N3               &kp N4                &kp N5                   &kp C_VOL_UP       &kp N6               &kp N7                   &kp N8               &kp N9                          &kp N0                           &kp BACKSPACE
&kp TAB                  &long_press EXCLAMATION Q  &long_press AT_SIGN W  &long_press POUND E  &long_press DOLLAR R  &long_press PERCENT T    &kp C_VOLUME_DOWN  &long_press CARET Y  &long_press AMPERSAND U  &long_press ASTRK I  &long_press LEFT_PARENTHESIS O  &long_press RIGHT_PARENTHESIS P  &long_press PIPE BSLH
&kp LEFT_SHIFT           &mt LSHIFT A               &mt LCTRL S            &mt LGUI D           &mt LALT F            &kp G                    &kp C_POWER        &kp H                &kp J                    &kp K                &kp L                           &fast_mt RSHIFT SEMI             &long_press DOUBLE_QUOTES APOS
&kp LCTRL                &kp Z                      &kp X                  &kp C                &kp V                 &kp B                    &kp K_CMENU        &kp N                &kp M                    &kp COMMA            &kp DOT                         &long_press QUESTION FSLH        &fast_mt RCTRL ENTER
&none                    &none                      &kp LEFT_GUI           &kp LEFT_ALT         &fast_lt 1 SPACE      &fast_lt 2 ENTER         &kp K_CALC         &fast_lt 2 ESC       &fast_lt 1 BACKSPACE     &kp DEL              &kp PAGE_DOWN                   &kp PAGE_UP
            >;

            display-name = "L0";
        };

        NUMS {
            bindings = <
&trans  &trans         &trans        &trans       &trans  &trans       &mmv MOVE_UP     &none   &none   &kp KP_SLASH  &kp KP_ASTERISK  &kp KP_MINUS      &trans
&trans  &kp N1         &kp N4        &kp N7       &kp N0  &kp LANG1    &mmv MOVE_DOWN   &none   &kp N7  &kp N8        &kp N9           &kp KP_PLUS       &trans
&trans  &mt LSHIFT N2  &mt LCTRL N5  &mt LGUI N8  &trans  &kp LANG2    &mmv MOVE_LEFT   &none   &kp N4  &kp N5        &kp N6           &mt RSHIFT ENTER  &trans
&trans  &kp N3         &kp N6        &kp N9       &trans  &kp LANG3    &mmv MOVE_RIGHT  &none   &kp N1  &kp N2        &kp N3           &trans            &trans
&trans  &trans         &trans        &trans       &trans  &trans       &mkp LCLK        &trans  &trans  &kp N0        &kp N0           &mt RCTRL DOT
            >;

            display-name = "NUM";
        };

        vim-mo_fun {
            bindings = <
&trans  &trans         &trans        &trans       &trans        &trans    &trans      &trans      &trans         &trans       &trans     &trans            &trans
&trans  &kp F1         &kp F4        &kp F7       &kp F10       &trans    &trans      &trans      &trans         &kp INS      &trans     &kp PSCRN         &trans
&trans  &mt LSHIFT F2  &mt LCTRL F5  &mt LGUI F8  &mt LALT F11  &trans    &kp C_PREV  &kp LEFT    &kp DOWN       &kp UP       &kp RIGHT  &mt RSHIFT ENTER  &trans
&trans  &kp F3         &kp F6        &kp F9       &kp F12       &trans    &kp C_NEXT  &kp KP_NUM  &kp PAGE_DOWN  &kp PAGE_UP  &trans     &trans            &trans
&trans  &trans         &trans        &trans       &trans        &trans    &kp C_PP    &trans      &trans         &trans       &trans     &trans
            >;

            display-name = "VIM_F";
        };

        SYS {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &mmv MOVE_UP     &trans           &trans           &trans           &trans           &trans       &trans
&trans  &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans            &mmv MOVE_DOWN   &rgb_ug RGB_ON   &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &trans       &trans
&trans  &out OUT_USB  &out OUT_BLE    &trans        &trans        &studio_unlock    &mmv MOVE_LEFT   &rgb_ug RGB_OFF  &rgb_ug RGB_EFR  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &trans       &trans
&trans  &sys_reset    &trans          &bootloader   &trans        &trans            &mmv MOVE_RIGHT  &trans           &trans           &sys_reset       &soft_off        &bootloader  &trans
&trans  &trans        &trans          &trans        &trans        &trans            &mkp LCLK        &trans           &trans           &trans           &trans           &trans
            >;

            display-name = "SYS";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
